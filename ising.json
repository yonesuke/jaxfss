.Rngs(42))\nmodel = jaxfss.FSSModel(scaling_fn=scaling_fn, n_critical=2, bijector=bijector)\n\ntrain_data = dataset.train_data\nLs = train_data[\"system_size\"]\nTs = train_data[\"temperature\"]\nAs = train_data[\"observable\"]\nvAs = train_data[\"observable_var\"]\n\ndef loss_fn(m: jaxfss.FSSModel):\n    y_pred = m(Ls, Ts)\n    return jaxfss.NLLLoss(As, y_pred, vAs)","key":"Y0uFBaHcX4"},{"type":"outputs","id":"Z82i73HO26WJBAwTdX8qa","children":[],"key":"ZZxddvT8yc"}],"key":"jur2xm2u6j"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Optimization with NNX","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"X7IEXkHi5e"}],"identifier":"id-4-optimization-with-nnx","label":"4. Optimization with NNX","html_id":"id-4-optimization-with-nnx","implicit":true,"key":"haPYK4cMNs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We optimize the NNX model using ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"E0QfH3OxPh"},{"type":"inlineCode","value":"jaxfss.fit","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VcO9xW6Ijz"},{"type":"text","value":" with multi-optimizer support.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lVGhntZxd9"}],"key":"u5JXb053Ms"}],"key":"BH2K5HqRDr"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-19T08:22:01.122446Z","iopub.status.busy":"2026-09-19T08:22:01.122352Z","iopub.status.idle":"2026-09-19T08:22:01.904876Z","shell.execute_reply":"2026-09-19T08:22:01.904418Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"optimizer = {\n    \"scaling_fn\": optax.adam(learning_rate=1e-3),\n    \"fss\": optax.adam(learning_rate=1e-2)\n}\nsteps = 8000\n\nlosses, critical_vals = jaxfss.fit(model, loss_fn, optimizer, steps)\n\nc1_est, scaled_Tc_est = model.critical_params\nTc_est = float(dataset.bij_temperature.inverse(scaled_Tc_est))\nc1_est = float(c1_est)\n\nprint(\"=== Estimation Results ===\")\nprint(f\"c_1 (exact = 1.0)       : {c1_est:.5f}\")\nprint(f\"1/Tc (exact = 0.44069)  : {Tc_est:.5f}\")","key":"oM4K8iiWbg"},{"type":"outputs","id":"OwK-aO3Y4Npl46HaxyxmR","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"=== Estimation Results ===\nc_1 (exact = 1.0)       : 0.99059\n1/Tc (exact = 0.44069)  : 0.44070\n"},"children":[],"key":"dWA3Q6G6CU"}],"key":"tWZwdtlm7R"}],"key":"pMW9pPXR41"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Scaling Collapse and NN Fitting Curve","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lQUD8ulPnX"}],"identifier":"id-5-scaling-collapse-and-nn-fitting-curve","label":"5. Scaling Collapse and NN Fitting Curve","html_id":"id-5-scaling-collapse-and-nn-fitting-curve","implicit":true,"key":"EP1FbXScSD"}],"key":"iF35Vb7LTY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-19T08:22:01.906167Z","iopub.status.busy":"2026-09-19T08:22:01.906066Z","iopub.status.idle":"2026-09-19T08:22:02.451414Z","shell.execute_reply":"2026-09-19T08:22:02.450979Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4.5))\n\n# Loss curve\nax1.plot(losses)\nax1.set_yscale(\"log\")\nax1.set_xlabel(\"Step\")\nax1.set_ylabel(\"NLL Loss\")\nax1.set_title(\"Training Loss Curve\")\nax1.grid(True, alpha=0.3)\n\n# Scaling collapse\nfor L in unique_Ls:\n    idx = dataset.Ls.flatten() == L\n    t = Ts.flatten()[idx]\n    s = Ls.flatten()[idx]\n    x = (t - scaled_Tc_est) * (s ** c1_est)\n    y = As.flatten()[idx]\n    yerr = jnp.sqrt(vAs.flatten()[idx])\n    ax2.errorbar(x, y, yerr=yerr, fmt=\"o\", label=f\"$L={int(L)}$\", alpha=0.7, capsize=2)\n\n# Plot NN prediction\nx_grid = jnp.linspace(-1.0, 1.0, 200).reshape(-1, 1)\ny_pred = model.scaling_fn(x_grid)\nax2.plot(x_grid, y_pred, color=\"black\", lw=2, linestyle=\"--\", label=\"NN $F(X)$\")\n\nax2.set_xlabel(r\"Scaled temperature $X = (T - T_{\\mathrm{c}}) L^{c_1}$\", fontsize=11)\nax2.set_ylabel(r\"$Y = U(T, L)$\", fontsize=11)\nax2.set_title(f\"Data Collapse ($c_1={c1_est:.4f}, 1/T_c={Tc_est:.4f}$)\", fontsize=12)\nax2.legend()\nax2.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()","key":"lGlazbt1XP"},{"type":"outputs","id":"gPFS-F8ZlRNmeefm9AOHA","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4cb43596324eb2562ea9b66f0f7dbab5","path":"/jaxfss/build/4cb43596324eb2562ea9b66f0f7dbab5.png"},"text/plain":{"content":"<Figure size 1300x450 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"QSiSWeK3cb"}],"key":"s6w7NxZH9z"}],"key":"kQtuYILyLt"}],"key":"FWH0gKBmTA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Usage","url":"/usage","group":"Guides"},"next":{"title":"Two-Dimensional Bond Percolation Model","url":"/percolation","group":"Examples"}}},"domain":"http://localhost:3000"}