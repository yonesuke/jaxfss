"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VNC6lrJIx1"}],"key":"gjJAGMk0ce"}],"key":"zAEJFOocJ5"}],"key":"cFlfcyiufl"}],"key":"GVVncFNnMD"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-19T08:21:45.114604Z","iopub.status.busy":"2026-09-19T08:21:45.114507Z","iopub.status.idle":"2026-09-19T08:21:45.563488Z","shell.execute_reply":"2026-09-19T08:21:45.563034Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"bij_c1 = SoftClip(low=0.0)\nbij_c2 = SoftClip(high=0.0)\nbij_pc = SoftClip(low=-1.0, high=1.0)\n\ndef bijector(p):\n    p1, p2, pc = p\n    return jnp.array([\n        bij_c1.forward(p1),\n        bij_c2.forward(p2),\n        bij_pc.forward(pc)\n    ])\n\nscaling_fn = jaxfss.RationalMLP(din=1, features=[20, 20, 1], rngs=nnx.Rngs(42))\nmodel = jaxfss.FSSModel(scaling_fn=scaling_fn, n_critical=3, bijector=bijector)\n\ntrain_data = dataset.train_data\nLs = train_data[\"system_size\"]\nTs = train_data[\"temperature\"]\nAs = train_data[\"observable\"]\nvAs = train_data[\"observable_var\"]\n\ndef loss_fn(m: jaxfss.FSSModel):\n    y_pred = m(Ls, Ts)\n    c2 = m.critical_params[1]\n    y_true = m.scaled_target(Ls, As)\n    V = vAs * (Ls ** (2 * c2))\n    return jaxfss.NLLLoss(y_true, y_pred, V)","key":"s1wOABEc7i"},{"type":"outputs","id":"YY6NTbK5Igw_WObCRYhu0","children":[],"key":"AkLa1UYpI2"}],"key":"xyS6NbUpHE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"4. Optimization with NNX","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ELtjMZMvnh"}],"identifier":"id-4-optimization-with-nnx","label":"4. Optimization with NNX","html_id":"id-4-optimization-with-nnx","implicit":true,"key":"MqQ19laV57"}],"key":"tK13Ikxm0Q"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-19T08:21:45.564913Z","iopub.status.busy":"2026-09-19T08:21:45.564837Z","iopub.status.idle":"2026-09-19T08:21:46.775853Z","shell.execute_reply":"2026-09-19T08:21:46.775490Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"optimizer = {\n    \"scaling_fn\": optax.adam(learning_rate=1e-3),\n    \"fss\": optax.adam(learning_rate=1e-2)\n}\nsteps = 10000\n\nlosses, critical_vals = jaxfss.fit(model, loss_fn, optimizer, steps)\n\nc1_est, c2_est, scaled_pc_est = model.critical_params\npc_est = float(dataset.bij_temperature.inverse(scaled_pc_est))\nc1_est = float(c1_est)\nc2_est = float(c2_est)\n\nprint(\"=== Estimation Results ===\")\nprint(f\"c_1 (exact = 0.75000)   : {c1_est:.5f}\")\nprint(f\"c_2 (exact = -1.75000)  : {c2_est:.5f}\")\nprint(f\"p_c (exact = 0.50000)   : {pc_est:.5f}\")","key":"uubrlnpKPG"},{"type":"outputs","id":"5qbBiOZ_QSCxPqQmycmAe","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"=== Estimation Results ===\nc_1 (exact = 0.75000)   : 0.75248\nc_2 (exact = -1.75000)  : -1.76042\np_c (exact = 0.50000)   : 0.50026\n"},"children":[],"key":"aw52l8dWcc"}],"key":"mpnTKDXreT"}],"key":"ICHsh2zlqD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5. Scaling Collapse and NN Fitting Curve","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ti3kOBEKGI"}],"identifier":"id-5-scaling-collapse-and-nn-fitting-curve","label":"5. Scaling Collapse and NN Fitting Curve","html_id":"id-5-scaling-collapse-and-nn-fitting-curve","implicit":true,"key":"btYDWRRpQP"}],"key":"KXkesSH3Dg"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-09-19T08:21:46.777176Z","iopub.status.busy":"2026-09-19T08:21:46.777089Z","iopub.status.idle":"2026-09-19T08:21:47.267978Z","shell.execute_reply":"2026-09-19T08:21:47.267543Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 4.5))\n\n# Loss curve\nax1.plot(losses)\nax1.set_yscale(\"log\")\nax1.set_xlabel(\"Step\")\nax1.set_ylabel(\"NLL Loss\")\nax1.set_title(\"Training Loss Curve\")\nax1.grid(True, alpha=0.3)\n\n# Scaling collapse\nfor L in unique_Ls:\n    idx = dataset.Ls.flatten() == L\n    t = Ts.flatten()[idx]\n    s = Ls.flatten()[idx]\n    x = (t - scaled_pc_est) * (s ** c1_est)\n    y = As.flatten()[idx] * (s ** c2_est)\n    yerr = jnp.sqrt(vAs.flatten()[idx]) * (s ** c2_est)\n    ax2.errorbar(x, y, yerr=yerr, fmt=\"o\", label=f\"$L={int(L)}$\", alpha=0.7, capsize=2)\n\n# Plot NN prediction\nx_grid = jnp.linspace(-1.0, 1.0, 200).reshape(-1, 1)\ny_pred = model.scaling_fn(x_grid)\nax2.plot(x_grid, y_pred, color=\"black\", lw=2, linestyle=\"--\", label=\"NN $F(X)$\")\n\nax2.set_xlabel(r\"Scaled probability $X = (p - p_{\\mathrm{c}}) L^{c_1}$\", fontsize=11)\nax2.set_ylabel(r\"$Y = \\chi^{\\mathrm{f}}(p, L) L^{c_2}$\", fontsize=11)\nax2.set_title(f\"Data Collapse ($c_1={c1_est:.4f}, c_2={c2_est:.4f}, p_c={pc_est:.4f}$)\", fontsize=12)\nax2.legend()\nax2.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.show()","key":"kgKyjugk3n"},{"type":"outputs","id":"VQ3A_U92Lj1V1tRzOCuWC","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d0d97dc1a404308b1cc8aeb00a942426","path":"/jaxfss/build/d0d97dc1a404308b1cc8aeb00a942426.png"},"text/plain":{"content":"<Figure size 1300x450 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"lHhbiWRlZ1"}],"key":"IrIWohfvJV"}],"key":"SX3q57rvmf"}],"key":"iCqJCNWxIJ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Two-Dimensional Ising Model","url":"/ising","group":"Examples"}}},"domain":"http://localhost:3000"}