span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span><span style=\"top:-3.113em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.247em;\"><span></span></span></span></span></span></span><span class=\"mclose\">)</span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size4\">]</span></span></span></span></span></span></span>","enumerator":"2","key":"GAnyskzMMj"},{"type":"code","lang":"python","value":"loss = jaxfss.NLLLoss(y_true, y_pred, var)","position":{"start":{"line":130,"column":1},"end":{"line":132,"column":1}},"key":"CSEmYlvijU"},{"type":"thematicBreak","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"TPrOT5u4oS"},{"type":"heading","depth":2,"position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"5. Optimization (","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"uSBorbJUf0"},{"type":"inlineCode","value":"fit","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"tC7OvGQaPc"},{"type":"text","value":")","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"UbWQ6ePSmH"}],"identifier":"id-5-optimization-fit","label":"5. Optimization (fit)","html_id":"id-5-optimization-fit","implicit":true,"key":"XPVoOUpZSb"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"inlineCode","value":"jaxfss.fit","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"Vp8YTYNHMw"},{"type":"text","value":" executes a JIT-compiled optimization loop using Flax NNX and Optax.\nBecause NNX models are stateful, model parameters are updated in-place.","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"Y1oZBize2e"}],"key":"pYUySCtGBQ"},{"type":"code","lang":"python","value":"import optax\nimport jaxfss\n\n# Define loss function on the model\ndef loss_fn(m: jaxfss.FSSModel):\n    y_pred = m(Ls, Ts)\n    y_true = m.scaled_target(Ls, As)\n    return jaxfss.MSELoss(y_true, y_pred)\n\n# Multi-optimizer: separate learning rates for NN weights and critical exponents\noptimizer = {\n    \"scaling_fn\": optax.adam(learning_rate=1e-3),\n    \"fss\": optax.adam(learning_rate=1e-2),\n}\n\nsteps = 10000\nlosses, critical_vals = jaxfss.fit(model, loss_fn, optimizer, steps)\n\n# Model parameters are updated in-place:\nc1, c2, scaled_Tc = model.critical_params\nphysical_Tc = dataset.bij_temperature.inverse(scaled_Tc)","position":{"start":{"line":141,"column":1},"end":{"line":163,"column":1}},"key":"dP1oSsqjkk"}],"key":"sjawrdSD23"}],"key":"wz7m9PEsM4"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Neural Scaling Analysis (NSA)","url":"/nsa","group":"Guides"},"next":{"title":"2D Ferromagnetic Ising Model Simulation with Metropolis Monte Carlo","url":"/ising-simulation","group":"Data Generation"}}},"domain":"http://localhost:3000"}